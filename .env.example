# Copy to .env.local for development. In production, set these in the Vercel project.

# Signs session cookies. Generate with: openssl rand -hex 32
# Rotating it signs everyone out.
SESSION_SECRET=

# The password family members type to see the album.
# Changing it signs out everyone who used the old one.
FAMILY_PASSWORD=

# Your password. Same login box; unlocks uploading and deleting. Must differ from FAMILY_PASSWORD.
ADMIN_PASSWORD=

# Set automatically when a Blob store is connected to the Vercel project.
# For local dev, use a separate "dev" store so you never touch the real photos.
BLOB_READ_WRITE_TOKEN=
